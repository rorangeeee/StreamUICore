{
  "formatVersion": 1,
  "sdkVersion": 1,
  "id": "latenite",
  "name": "LATENITE 多场景",
  "version": "1.0.0",
  "description": "3840 × 2160 双布局，保留弹幕、字标、音频可视化、暂离条带与像素转场。",
  "defaultScene": "ultrawide",
  "awayScene": "away",
  "settingsPage": "settings.html",
  "defaults": "defaults.json",
  "scenes": [
    {
      "id": "ultrawide",
      "name": "21:9 · 超宽主画面",
      "view": "21:9",
      "obsScene": "STREAM_v2_34",
      "entry": "ui/index.html",
      "width": 3840,
      "height": 2160,
      "runtimeGroup": "overlay"
    },
    {
      "id": "fullscreen",
      "name": "16:9 · 全画布叠加",
      "view": "16:9",
      "obsScene": "STREAM_v2_27",
      "entry": "ui/index.html",
      "width": 3840,
      "height": 2160,
      "runtimeGroup": "overlay"
    },
    {
      "id": "away",
      "name": "暂离",
      "view": "away",
      "obsScene": "",
      "entry": "ui/index.html",
      "width": 3840,
      "height": 2160,
      "runtimeGroup": "overlay"
    }
  ],
  "plugins": [
    {
      "id": "desktop-audio",
      "minimumVersion": "1.0.0",
      "required": true
    },
    {
      "id": "system-media",
      "minimumVersion": "1.0.0",
      "required": true
    }
  ]
}